                Тело = Новый Структура;
                Тело.Вставить("question", Вопрос);
                Если TopK>0 Тогда
                               Тело.Вставить("top_k", ?(TopK > 0, TopK, 10));
                КонецЕсли;
                Если ЗначениеЗаполнено(Категория) Тогда
                               Тело.Вставить("category", Категория);
                КонецЕсли;
               
                Данные = ВыполнитьPOST("/ask", СформироватьJSON(Тело));
               
