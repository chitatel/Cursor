                               ПолеОтвета = "Ошибка соединения с сервисом. Проверьте что RAG-сервис запущен.";
                               Возврат Неопределено;
                КонецЕсли;
               
                Результат = Новый Структура("Ответ, Источники, СсылкаНаФайл");
                Результат.Ответ = Данные["answer_html"];
               
                Источники = Данные["sources"];
                СтрокаИсточников = "";
                Для Каждого Ист Из Источники Цикл
                               СтрокаИсточников = СтрокаИсточников
                                               + ?(ПустаяСтрока(СтрокаИсточников), "", ", ") + Ист;
                КонецЦикла;
                Результат.Источники = СтрокаИсточников;
               
                //СсылкиНаФайлы = Данные["download_urls"];
                //Если СсылкиНаФайлы <> Неопределено И Источники.Количество() > 0 Тогда
                //            Результат.СсылкаНаФайл = СсылкиНаФайлы[Источники[0]];
                //КонецЕсли;
               
                Возврат Результат;
               
