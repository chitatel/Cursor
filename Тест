Процедура УдалитьДокумент(Команда)
               
                ТекСтрока = Элементы.ТаблицаДокументов.ТекущаяСтрока;
                Если ТекСтрока = Неопределено Тогда
                               Предупреждение("Выберите документ в списке");
                               Возврат;
                КонецЕсли;
               
                ИмяФайла = Объект.ТаблицаДокументов[ТекСтрока].ИмяФайла;
               
