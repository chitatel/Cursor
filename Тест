                Вопрос = Объект.ПолеВопроса;
                Если ПустаяСтрока(Вопрос) Тогда
                               Предупреждение("Введите вопрос");
                               Возврат;
                КонецЕсли;
               
                Объект.ПолеОтвета     = "Думаю...";
                Объект.ПолеИсточников = "";
                Объект.ПолеСсылки     = "";
               
                Результат = ЗадатьВопросНаСервере(Вопрос, Объект.ЗначениеTopK);
               
                Если Результат = Неопределено Тогда
                               Возврат;
                КонецЕсли;
               
                Объект.ПолеОтвета     = СтрЗаменить(Результат.Ответ, "\n", Символы.ПС);
                Объект.ПолеИсточников = Результат.Источники;
               
                Если НЕ ПустаяСтрока(Результат.СсылкаНаФайл) Тогда
                               Объект.ПолеСсылки = Результат.СсылкаНаФайл;
                КонецЕсли;
               
