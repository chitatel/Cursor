Процедура ЗагрузитьИзПортала(Команда)
               // Загружает статью корпоративной Базы знаний по URL.
               // Требует:
               //   - на форме реквизит Объект.ПолеURL (Строка) с введённой ссылкой
               //   - выбранную категорию "Portal" (или другую — спросит)

               URL = СокрЛП(Строка(Объект.ПолеURL));
               Если ПустаяСтрока(URL) Тогда
                              Предупреждение("Введите URL статьи Базы знаний в поле URL");
                              Возврат;
               КонецЕсли;

               КатегорияДляЗагрузки = ТекущаяКатегория();
               Если КатегорияДляЗагрузки <> "Portal" Тогда
                              Текст = "Текущая категория «" + КатегорияДляЗагрузки + "», а не «Portal».
                                      |Загружать статью с портала всё равно?";
                              Если Вопрос(Текст, РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
                                             Возврат;
                              КонецЕсли;
               КонецЕсли;

               Результат = ЗагрузитьИзПорталаНаСервере(URL, КатегорияДляЗагрузки);

               Если Результат <> Неопределено Тогда
                              ПоказатьОповещениеПользователя(
                                             "Статья загружается",
                                             ,
                                             Результат["filename"] + " — индексация запущена",
                                             БиблиотекаКартинок.Информация32
                              );
                              Объект.ПолеURL = "";
                              ПодключитьОбработчикОжидания("ОбновитьСписокОжидание", 5, Истина);
               КонецЕсли;

