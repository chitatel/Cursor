                               НоваяСтрока.Чанков   = Элемент["chunks"];
                               НоваяСтрока.Категория = Элемент["category"];
                               НоваяСтрока.Статус   = СтатусНаРусском(Элемент["indexing_status"]);
                               НоваяСтрока.СсылкаНаФайл = Элемент["download_url"];
                КонецЦикла;
               
КонецПроцедуры
 
&НаСервере
Функция ЗагрузитьФайлНаСервере(АдресФайлаВоВременномХранилище, ИмяФайла, Категория)

               ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайлаВоВременномХранилище);
               Если ДвоичныеДанныеФайла = Неопределено Тогда
                              ЗаписатьОшибку("Загрузка файла: файл не найден во временном хранилище");
                              Возврат Ложь;
               КонецЕсли;

               Граница = "----1CFormBoundary" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
               ПереводСтроки = Символы.ВК + Символы.ПС;
 
                ПотокТела = Новый ПотокВПамяти;
                ЗаписьТела = Новый ЗаписьДанных(
                               ПотокТела,
                               КодировкаТекста.UTF8,
                               ПорядокБайтов.LittleEndian,
                               "",
                               "",
                               Ложь);
 
                // Поле file.
                ЗаписатьСтрокуUTF8(ЗаписьТела, "--" + Граница + ПереводСтроки);
                ЗаписатьСтрокуUTF8(
                               ЗаписьТела,
                               "Content-Disposition: form-data; name=""file""; filename=""" + ИмяФайла + """" + ПереводСтроки);
                ЗаписатьСтрокуUTF8(ЗаписьТела, "Content-Type: application/octet-stream" + ПереводСтроки);
                ЗаписатьСтрокуUTF8(ЗаписьТела, ПереводСтроки);
 
               ЗаписьТела.Записать(ДвоичныеДанныеФайла);
               ЗаписатьСтрокуUTF8(ЗаписьТела, ПереводСтроки);
 
               // Поле category.
               Если ЗначениеЗаполнено(Категория) Тогда
                              ЗаписатьСтрокуUTF8(ЗаписьТела, "--" + Граница + ПереводСтроки);
                              ЗаписатьСтрокуUTF8(
                                              ЗаписьТела,
                                              "Content-Disposition: form-data; name=""category""" + ПереводСтроки);
                              ЗаписатьСтрокуUTF8(ЗаписьТела, ПереводСтроки);
                              ЗаписатьСтрокуUTF8(ЗаписьТела, Категория + ПереводСтроки);
               КонецЕсли;
 
                ЗаписатьСтрокуUTF8(ЗаписьТела, "--" + Граница + "--" + ПереводСтроки);
 
                ЗаписьТела.Закрыть();
                ДвоичныеДанныеТела = ПотокТела.ЗакрытьИПолучитьДвоичныеДанные();
 
                Соединение = Новый HTTPСоединение(АдресСервисаСервер(), АдресСервисаПорт(), ,,, 120);
 
 
                ПутьЗапроса = "/documents";
 
                Запрос = Новый HTTPЗапрос(ПутьЗапроса);
                Запрос.Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Граница);
                Запрос.Заголовки.Вставить("Accept", "application/json");
 
                Запрос.УстановитьТелоИзДвоичныхДанных(ДвоичныеДанныеТела);
 
                Ответ = Соединение.ОтправитьДляОбработки(Запрос);
                КодСостояния = Ответ.КодСостояния;
                ТелоОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
 
                Если КодСостояния < 200 Или КодСостояния >= 300 Тогда
                               ТекстОшибки = "Ошибка загрузки файла в /documents. HTTP " + Строка(КодСостояния) + ": " + ТелоОтвета;
                               ВызватьИсключение ТекстОшибки;
                КонецЕсли;
 
               Возврат КодСостояния = 202;
               
КонецФункции

&НаСервере
Функция ПодготовитьФайлНаСервере(АдресФайлаВоВременномХранилище, ИмяФайла)

               ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайлаВоВременномХранилище);
               Если ДвоичныеДанныеФайла = Неопределено Тогда
                              ЗаписатьОшибку("Подготовка файла: файл не найден во временном хранилище");
                              Возврат Неопределено;
               КонецЕсли;

               Граница = "----1CFormBoundary" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
               ПереводСтроки = Символы.ВК + Символы.ПС;

               ПотокТела = Новый ПотокВПамяти;
               ЗаписьТела = Новый ЗаписьДанных(
                              ПотокТела,
                              КодировкаТекста.UTF8,
                              ПорядокБайтов.LittleEndian,
                              "",
                              "",
                              Ложь);

               ЗаписатьСтрокуUTF8(ЗаписьТела, "--" + Граница + ПереводСтроки);
               ЗаписатьСтрокуUTF8(
                              ЗаписьТела,
                              "Content-Disposition: form-data; name=""file""; filename=""" + ИмяФайла + """" + ПереводСтроки);
               ЗаписатьСтрокуUTF8(ЗаписьТела, "Content-Type: application/octet-stream" + ПереводСтроки);
               ЗаписатьСтрокуUTF8(ЗаписьТела, ПереводСтроки);
               ЗаписьТела.Записать(ДвоичныеДанныеФайла);
               ЗаписатьСтрокуUTF8(ЗаписьТела, ПереводСтроки);
               ЗаписатьСтрокуUTF8(ЗаписьТела, "--" + Граница + "--" + ПереводСтроки);

               ЗаписьТела.Закрыть();
               ДвоичныеДанныеТела = ПотокТела.ЗакрытьИПолучитьДвоичныеДанные();

               Соединение = Новый HTTPСоединение(АдресСервисаСервер(), АдресСервисаПорт(), ,,, 600);
               Запрос = Новый HTTPЗапрос("/documents/prepare");
               Запрос.Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Граница);
               Запрос.Заголовки.Вставить("Accept", "application/json");
               Запрос.УстановитьТелоИзДвоичныхДанных(ДвоичныеДанныеТела);

               Ответ = Соединение.ОтправитьДляОбработки(Запрос);
               Если Ответ.КодСостояния <> 200 Тогда
                              ЗаписатьОшибку("POST /documents/prepare → " + Строка(Ответ.КодСостояния) + ": " + Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
                              Возврат Неопределено;
               КонецЕсли;

               Возврат РазобратьJSON(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));

КонецФункции
 
