// Клиентский файл -> временное хранилище 1С -> POST /documents.
// FastAPI endpoint:
// POST /documents
// multipart/form-data:
//   file     = файл
//   category = строка категории

&НаКлиенте
Процедура ЗагрузитьКлиентскийФайлВДокументы(
	ХостСервера,
	Порт,
	ПутьКФайлуНаКлиенте,
	Категория,
	ИспользоватьSSL = Ложь,
	ПрефиксПути = "") Экспорт

	Файл = Новый Файл(ПутьКФайлуНаКлиенте);

	Контекст = Новый Структура;
	Контекст.Вставить("ХостСервера", ХостСервера);
	Контекст.Вставить("Порт", Порт);
	Контекст.Вставить("ИмяФайла", Файл.Имя);
	Контекст.Вставить("Категория", Категория);
	Контекст.Вставить("ИспользоватьSSL", ИспользоватьSSL);
	Контекст.Вставить("ПрефиксПути", ПрефиксПути);

	Оповещение = Новый ОписаниеОповещения(
		"ЗагрузитьКлиентскийФайлВДокументыЗавершение",
		ЭтотОбъект,
		Контекст);

	ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	ПараметрыЗагрузки.ИдентификаторФормы = УникальныйИдентификатор;
	ПараметрыЗагрузки.Интерактивно = Ложь;

	ФайловаяСистемаКлиент.ЗагрузитьФайл(
		Оповещение,
		ПараметрыЗагрузки,
		ПутьКФайлуНаКлиенте);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьКлиентскийФайлВДокументыЗавершение(ПомещенныйФайл, Контекст) Экспорт

	Если ПомещенныйФайл = Неопределено Тогда
		ВызватьИсключение "Файл не был помещен во временное хранилище.";
	КонецЕсли;

	ОтветJSON = ЗагрузитьФайлИзВременногоХранилищаВДокументы(
		Контекст.ХостСервера,
		Контекст.Порт,
		Контекст.ИмяФайла,
		ПомещенныйФайл.Хранение,
		Контекст.Категория,
		Контекст.ИспользоватьSSL,
		Контекст.ПрефиксПути);

	Сообщить(ОтветJSON);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗагрузитьФайлИзВременногоХранилищаВДокументы(
	ХостСервера,
	Порт,
	ИмяФайла,
	АдресФайлаВоВременномХранилище,
	Категория,
	ИспользоватьSSL = Ложь,
	ПрефиксПути = "") Экспорт

	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайлаВоВременномХранилище);

	Возврат ЗагрузитьДвоичныеДанныеВДокументы(
		ХостСервера,
		Порт,
		ИмяФайла,
		ДвоичныеДанныеФайла,
		Категория,
		ИспользоватьSSL,
		ПрефиксПути);

КонецФункции

&НаСервереБезКонтекста
Функция ЗагрузитьДвоичныеДанныеВДокументы(
	ХостСервера,
	Порт,
	ИмяФайла,
	ДвоичныеДанныеФайла,
	Категория,
	ИспользоватьSSL = Ложь,
	ПрефиксПути = "")

	Граница = "----1CFormBoundary" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	ПереводСтроки = Символы.ВК + Символы.ПС;

	ПотокТела = Новый ПотокВПамяти;
	ЗаписьТела = Новый ЗаписьДанных(
		ПотокТела,
		КодировкаТекста.UTF8,
		ПорядокБайтов.LittleEndian,
		"",
		"",
		Ложь);

	ЗаписатьСтрокуUTF8(ЗаписьТела, "--" + Граница + ПереводСтроки);
	ЗаписатьСтрокуUTF8(
		ЗаписьТела,
		"Content-Disposition: form-data; name=""file""; filename=""" + ИмяФайла + """" + ПереводСтроки);
	ЗаписатьСтрокуUTF8(ЗаписьТела, "Content-Type: application/octet-stream" + ПереводСтроки);
	ЗаписатьСтрокуUTF8(ЗаписьТела, ПереводСтроки);

	БуферФайла = Новый БуферДвоичныхДанных(ДвоичныеДанныеФайла);
	ЗаписьТела.ЗаписатьБуферДвоичныхДанных(БуферФайла);
	ЗаписатьСтрокуUTF8(ЗаписьТела, ПереводСтроки);

	Если ЗначениеЗаполнено(Категория) Тогда
		ЗаписатьСтрокуUTF8(ЗаписьТела, "--" + Граница + ПереводСтроки);
		ЗаписатьСтрокуUTF8(
			ЗаписьТела,
			"Content-Disposition: form-data; name=""category""" + ПереводСтроки);
		ЗаписатьСтрокуUTF8(ЗаписьТела, ПереводСтроки);
		ЗаписатьСтрокуUTF8(ЗаписьТела, Категория + ПереводСтроки);
	КонецЕсли;

	ЗаписатьСтрокуUTF8(ЗаписьТела, "--" + Граница + "--" + ПереводСтроки);

	ЗаписьТела.Закрыть();
	ДвоичныеДанныеТела = ПотокТела.ЗакрытьИПолучитьДвоичныеДанные();

	Соединение = СоздатьHTTPСоединение(ХостСервера, Порт, ИспользоватьSSL);

	Если Прав(ПрефиксПути, 1) = "/" Тогда
		ПрефиксПути = Лев(ПрефиксПути, СтрДлина(ПрефиксПути) - 1);
	КонецЕсли;

	ПутьЗапроса = ПрефиксПути + "/documents";
	Если Лев(ПутьЗапроса, 1) <> "/" Тогда
		ПутьЗапроса = "/" + ПутьЗапроса;
	КонецЕсли;

	Запрос = Новый HTTPЗапрос(ПутьЗапроса);
	Запрос.Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Граница);
	Запрос.Заголовки.Вставить("Accept", "application/json");

	Запрос.УстановитьТелоИзДвоичныхДанных(ДвоичныеДанныеТела);

	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	КодСостояния = Ответ.КодСостояния;
	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);

	Если КодСостояния < 200 Или КодСостояния >= 300 Тогда
		ТекстОшибки = "Ошибка загрузки файла в /documents. HTTP " + Строка(КодСостояния) + ": " + ТелоОтвета;
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;

	Возврат ТелоОтвета;

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьСтрокуUTF8(ЗаписьТела, Строка) Экспорт

	ЗаписьТела.ЗаписатьСтроку(Строка);

КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьHTTPСоединение(ХостСервера, Порт, ИспользоватьSSL) Экспорт

	Если ИспользоватьSSL Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	Иначе
		ЗащищенноеСоединение = Неопределено;
	КонецЕсли;

	Возврат Новый HTTPСоединение(
		ХостСервера,
		Порт,
		,
		,
		,
		30,
		ЗащищенноеСоединение);

КонецФункции

