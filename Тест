&НаСервере
Функция ВыполнитьGET(Путь)
                Попытка
                               Соединение = Новый HTTPСоединение(АдресСервисаСервер(), АдресСервисаПорт(), ,,, 30);
                               Запрос     = Новый HTTPЗапрос(Путь);
                               Ответ      = Соединение.Получить(Запрос);
                               Если Ответ.КодСостояния <> 200 Тогда
                                               ЗаписатьОшибку("GET " + Путь + " → " + Ответ.КодСостояния);
                                               Возврат Неопределено;
                               КонецЕсли;
                               Возврат РазобратьJSON(Ответ.ПолучитьТелоКакСтроку());
                Исключение
                               ЗаписатьОшибку("GET " + Путь + ": " + ОписаниеОшибки());
                               Возврат Неопределено;
                КонецПопытки;
КонецФункции
 
&НаСервере
Функция ВыполнитьPOST(Путь, ТелоСтрока)    
      Заголовки = Новый Соответствие;
        Заголовки["Content-Type"] = "application/json; charset=utf-8";
        Соединение = Новый HTTPСоединение(АдресСервисаСервер(), АдресСервисаПорт(), ,,, 0);
        Запрос = Новый HTTPЗапрос(Путь, Заголовки);
        Запрос.УстановитьТелоИзСтроки(ТелоСтрока, "UTF-8");
        Ответ = Соединение.ОтправитьДляОбработки(Запрос);
        Если Ответ.КодСостояния <> 200 И Ответ.КодСостояния <> 202 Тогда
            ЗаписатьОшибку("POST " + Путь + " → " + Ответ.КодСостояния);
            Возврат Неопределено;
        КонецЕсли;
        Возврат РазобратьJSON(Ответ.ПолучитьТелоКакСтроку());
КонецФункции
 
