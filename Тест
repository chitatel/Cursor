&НаСервере
Процедура ЗагрузитьЛогиНаСервере()
                // Ожидается реквизит формы Объект.ТаблицаЛогов со следующими колонками:
                //   Дата          (Дата, состав: Дата и время) — конвертируется из ISO в локальное время
                //   Вопрос        (Строка)
                //   Категория     (Строка)
                //   Близость      (Число)   — best_similarity, 0..1
                //   Ответ         (Строка, многострочная)
                //   Источники     (Строка)
                //   Длительность  (Число)   — duration_ms
                //   Ошибка        (Строка)

                Объект.ТаблицаЛогов.Очистить();

                Данные = ВыполнитьGET("/logs?limit=200");
                Если Данные = Неопределено Тогда
                                Возврат;
                КонецЕсли;

                Для Каждого Элемент Из Данные Цикл
                                НоваяСтрока = Объект.ТаблицаЛогов.Добавить();
                                НоваяСтрока.Дата          = ISOВДату(Элемент["timestamp"]);
                                НоваяСтрока.Вопрос        = Элемент["question"];
                                НоваяСтрока.Категория     = Элемент["category"];
                                НоваяСтрока.Ответ         = Элемент["answer"];
                                НоваяСтрока.Ошибка        = Элемент["error"];
                                НоваяСтрока.Близость      = ?(Элемент["best_similarity"] = Неопределено, 0, Элемент["best_similarity"]);
                                НоваяСтрока.Длительность  = ?(Элемент["duration_ms"]     = Неопределено, 0, Элемент["duration_ms"]);

                                Источники = Элемент["sources"];
                                СтрокаИсточников = "";
                                Если Источники <> Неопределено Тогда
                                                Для Каждого Ист Из Источники Цикл
                                                                СтрокаИсточников = СтрокаИсточников
                                                                                + ?(ПустаяСтрока(СтрокаИсточников), "", ", ") + Ист;
                                                КонецЦикла;
                                КонецЕсли;
                                НоваяСтрока.Источники = СтрокаИсточников;
                КонецЦикла;

КонецПроцедуры


