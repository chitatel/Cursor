&НаСервере
Функция ISOВДату(СтрокаISO)
                // Формат сервера: 2026-04-30T11:47:56.530457+00:00 (фиксированной длины).
                // Парсим по позициям, миллисекунды и зону игнорируем.
                Если ТипЗнч(СтрокаISO) <> Тип("Строка") ИЛИ ПустаяСтрока(СтрокаISO) Тогда
                                Возврат Дата(1, 1, 1);
                КонецЕсли;
                Попытка
                                Год     = Число(Сред(СтрокаISO,  1, 4));
                                Месяц   = Число(Сред(СтрокаISO,  6, 2));
                                День    = Число(Сред(СтрокаISO,  9, 2));
                                Час     = Число(Сред(СтрокаISO, 12, 2));
                                Минута  = Число(Сред(СтрокаISO, 15, 2));
                                Секунда = Число(Сред(СтрокаISO, 18, 2));
                                Возврат Дата(Год, Месяц, День, Час, Минута, Секунда);
                Исключение
                                Возврат Дата(1, 1, 1);
                КонецПопытки;
КонецФункции
 
